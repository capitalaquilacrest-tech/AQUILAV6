{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aquilav6",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
